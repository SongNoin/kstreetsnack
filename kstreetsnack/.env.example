# 브라우저에서 Supabase에 연결할 때 쓰는 공개 설정입니다.
# Publishable key는 브라우저 코드에 보여도 되며, 실제 권한은 RLS가 제한합니다.
# Supabase Additional Redirect URL은 PKCE 전용 callback을 사용합니다.
# http://127.0.0.1:3000/admin/auth/callback/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 예전 프로젝트 호환용 anon JWT입니다. 새 프로젝트에서는 위 Publishable key를 사용하세요.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google OAuth Client ID와 Client Secret은 이 파일에 넣지 않습니다.
# Google Client Secret은 Supabase Authentication의 Google provider 설정에만 직접 입력하세요.

# 최초 seed와 verify:supabase에서만 쓰는 Secret key입니다.
# 절대 NEXT_PUBLIC_을 붙이지 말고 Git, 브라우저, 화면 캡처, 이메일,
# 메신저 또는 AI 채팅에 보내지 마세요. 본인이 .env.local에 직접 입력하세요.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 예전 프로젝트 호환용 service_role JWT입니다. 새 프로젝트에서는 위 Secret key를 사용하세요.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# [최초 설정 필수] Google로 처음 로그인해 생성된 Supabase Auth 사용자의 User UID(UUID)입니다.
# 첫 Google 로그인 뒤 Authentication > Users에서 이메일이 아닌 UID를 복사하세요.
SUPABASE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# seed와 verify가 끝나면 .env.local에서 Secret key, legacy service_role,
# SUPABASE_OWNER_USER_ID를 제거하고 개발 서버를 다시 시작하세요.

# 사이트 공개 파이프라인은 .env.local이 아니라 외부 비밀 저장소에서 설정합니다.
# GitHub Actions repository variables (공개 값):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# GitHub Actions repository secret:
#   MENU_DEPLOY_CALLBACK_SECRET
# Supabase Edge Function secrets:
#   GITHUB_ACTIONS_TOKEN
#   GITHUB_REPOSITORY
#   MENU_DEPLOY_CALLBACK_SECRET       # GitHub secret과 같은 값
#   ADMIN_ALLOWED_ORIGINS
# 선택 Edge Function secrets (기본값 deploy-pages.yml, master):
#   GITHUB_WORKFLOW_FILE
#   GITHUB_WORKFLOW_REF
# 자세한 설정: docs/menu-admin-deployment.md
